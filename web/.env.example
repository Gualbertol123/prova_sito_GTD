# Supabase connection for the frontend build.
# Copy to `.env` for local dev, or set these as environment variables in Netlify
# (Site settings → Environment variables). None of these is a secret — the
# anon key is meant to ship in the browser and the e-mail is only the login
# name of the shared team account; access is controlled by the team password
# (Supabase Auth) and RLS.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
VITE_TEAM_EMAIL=team@example.com
