# Supabase connection for the frontend build.
# Copy to `.env` for local dev, or set these as environment variables in Netlify
# (Site settings → Environment variables). Neither value is a real secret — the
# anon key is meant to ship in the browser; access is controlled by RLS.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
